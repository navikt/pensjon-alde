{
  "name": "alde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_ENV=development node --experimental-strip-types server.ts",
    "dev:pdf": "node --experimental-strip-types pdf/server.ts",
    "dev:mock": "NODE_ENV=mock react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "test": "vitest",
    "test:ci": "export CI=true && vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "STORYBOOK=true storybook dev -p 6006",
    "build-storybook": "STORYBOOK=true storybook build",
    "capture-screenshots": "tsx scripts/capture-screenshots.ts",
    "capture-docs-screenshots": "tsx scripts/capture-screenshots.ts --docs",
    "stress-pdf": "tsx scripts/stress-pdf.ts",
    "typecheck": "react-router typegen && tsc",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/ds-tokens": "^8.16.1",
    "@opentelemetry/api": "^1.9.1",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "isbot": "^5.2.1",
    "node-cache": "^5.1.2",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "remix-auth": "^4.2.0",
    "remix-auth-oauth2": "^3.4.1",
    "unleash-client": "^6.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "4.1.10",
    "glob": "^13.0.6",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "playwright": "1.62.1",
    "react-router-devtools": "^6.2.3",
    "storybook": "^10.5.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
